{
    "root": true,
    "extends": ["eslint:recommended", "plugin:react/recommended", "plugin:react-hooks/recommended", "prettier"],
    "plugins": ["react", "react-hooks"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "env": {
        "browser": true,
        "es2020": true,
        "node": true
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "warn",
        "no-unused-vars": "warn",
        "no-console": "warn"
    }
}
